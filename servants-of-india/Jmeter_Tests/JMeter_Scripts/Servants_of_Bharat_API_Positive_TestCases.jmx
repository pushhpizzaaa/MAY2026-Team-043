vars.put(&apos;TC_COMMENTS&apos;, &apos;&apos;)
vars.put(&apos;TC_EXPECTED_CODE&apos;, &apos;200&apos;)
vars.put(&apos;TC_EXPECTED_CONTAINS&apos;, &apos;[&quot;success&quot;]&apos;)
