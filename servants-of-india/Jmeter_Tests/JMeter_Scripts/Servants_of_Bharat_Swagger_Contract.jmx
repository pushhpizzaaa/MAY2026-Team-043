          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Validate OpenAPI paths documented">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">false</stringProp>
            <stringProp name="script">
import groovy.json.JsonSlurper
def body = prev.getResponseDataAsString()
def spec = new JsonSlurper().parseText(body)
def paths = spec.paths.keySet()
def required = new JsonSlurper().parseText(&apos;[&quot;/auth/login&quot;, &quot;/users/me&quot;, &quot;/events&quot;, &quot;/submissions&quot;, &quot;/certificates/generate&quot;, &quot;/progress/me&quot;, &quot;/notifications&quot;, &quot;/admin/stats&quot;, &quot;/verify/{verification_code}&quot;]&apos;)
def missing = required.findAll { !paths.contains(it) }
if (missing) {
    def msg = &apos;Missing paths in OpenAPI spec: &apos; + missing.join(&apos;, &apos;)
    vars.put(&apos;SC_VALIDATION_ERRORS&apos;, msg)
    AssertionResult.setFailureMessage(msg)
    AssertionResult.setFailure(true)
} else {
    vars.put(&apos;SC_VALIDATION_ERRORS&apos;, &apos;OK&apos;)
}
</stringProp>
          </JSR223Assertion>
