vars.put(&apos;SC_COMMENTS&apos;, &apos;Validated via JSR223 path check&apos;)
vars.put(&apos;SC_EXPECTED_CODE&apos;, &apos;200&apos;)
vars.put(&apos;SC_SCHEMA_RULES&apos;, &apos;&apos;)
vars.put(&apos;RESULTS_CSV&apos;, &apos;C:/D_Drive/Sankar/IITM/Degree/SE/Servants_of_Bharat/ForTesting/v2-bk/Software-Engineering-Project/Testing/TestCases/Swagger_Contract_TestCases_Results.csv&apos;)
</stringProp>
