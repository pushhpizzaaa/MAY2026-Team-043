          <stringProp name="cacheKey">false</stringProp>
          <stringProp name="script">
vars.put(&apos;SC_ID&apos;, &apos;SC-003&apos;)
vars.put(&apos;SC_SCENARIO&apos;, &apos;Auth register response schema (201 AuthResponse)&apos;)
vars.put(&apos;SC_STEPS&apos;, &apos;1. POST /api/auth/register | 2. Validate AuthResponse schema&apos;)
vars.put(&apos;SC_EXPECTED&apos;, &apos;201; AuthResponse: token + User with role enum&apos;)
vars.put(&apos;SC_INPUT&apos;, &apos;{&quot;full_name&quot;:&quot;Swagger Vol&quot;,&quot;email&quot;:&quot;swagger.${__UUID()}.@test.local&quot;,&quot;password&quot;:&quot;password1&quot;,&quot;phone&quot;:&quot;9876543210&quot;,&quot;location&quot;:&quot;Pune&quot;}&apos;)
