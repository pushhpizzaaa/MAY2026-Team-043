          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Validate Response Schema" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">false</stringProp>
            <stringProp name="script">
import groovy.json.JsonSlurper

def slurper = new JsonSlurper()
def errors = []

def checkType(name, val, type) {
    if (type == &apos;boolean&apos; &amp;&amp; !(val instanceof Boolean)) errors &lt;&lt; &quot;${name}: expected boolean&quot;
    else if (type == &apos;string&apos; &amp;&amp; !(val instanceof String)) errors &lt;&lt; &quot;${name}: expected string&quot;
    else if (type == &apos;integer&apos; &amp;&amp; !(val instanceof Number)) errors &lt;&lt; &quot;${name}: expected number&quot;
    else if (type == &apos;array&apos; &amp;&amp; !(val instanceof List)) errors &lt;&lt; &quot;${name}: expected array&quot;
    else if (type == &apos;object&apos; &amp;&amp; !(val instanceof Map)) errors &lt;&lt; &quot;${name}: expected object&quot;
}

def checkFormat(name, val, format) {
    if (!(val instanceof String)) return
    if (format == &apos;uuid&apos; &amp;&amp; !(val ==~ /[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}/))
        errors &lt;&lt; &quot;${name}: invalid uuid&quot;
    if (format == &apos;email&apos; &amp;&amp; !(val ==~ /[^@\s]+@[^@\s]+\.[^@\s]+/))
        errors &lt;&lt; &quot;${name}: invalid email&quot;
    if (format == &apos;date&apos; &amp;&amp; !(val ==~ /\d{4}-\d{2}-\d{2}/))
        errors &lt;&lt; &quot;${name}: invalid date&quot;
    if (format == &apos;date-time&apos; &amp;&amp; !(val ==~ /\d{4}-\d{2}-\d{2}T/))
        errors &lt;&lt; &quot;${name}: invalid date-time&quot;
}

def validateNode(node, schema, path) {
    if (!schema) return
    // Use bracket access — &apos;const&apos; is a Groovy reserved word
    if (schema.containsKey(&apos;const&apos;) &amp;&amp; node != schema[&apos;const&apos;])
        errors &lt;&lt; &quot;${path}: expected const ${schema[&apos;const&apos;]}&quot;
    if (schema[&apos;enum&apos;] &amp;&amp; !(node in schema[&apos;enum&apos;]))
        errors &lt;&lt; &quot;${path}: value not in enum ${schema[&apos;enum&apos;]}&quot;
    if (schema.type) checkType(path, node, schema.type)
    if (schema.format) checkFormat(path, node, schema.format)
    if (schema.minLength &amp;&amp; node instanceof String &amp;&amp; node.length() &lt; schema.minLength)
        errors &lt;&lt; &quot;${path}: minLength ${schema.minLength}&quot;
    if (schema.required &amp;&amp; node instanceof Map) {
        schema.required.each { f -&gt;
            if (!node.containsKey(f)) errors &lt;&lt; &quot;${path}.${f}: missing required field&quot;
        }
    }
    if (schema.properties &amp;&amp; node instanceof Map) {
        schema.properties.each { k, v -&gt;
            if (node.containsKey(k)) validateNode(node[k], v, &quot;${path}.${k}&quot;)
        }
    }
    if (schema.items &amp;&amp; node instanceof List) {
        node.eachWithIndex { item, i -&gt; validateNode(item, schema.items, &quot;${path}[${i}]&quot;) }
    }
}

def rulesJson = vars.get(&apos;SC_SCHEMA_RULES&apos;)
def expectedCode = vars.get(&apos;SC_EXPECTED_CODE&apos;) ?: &apos;200&apos;
def actualCode = prev.getResponseCode()
if (actualCode != expectedCode)
    errors &lt;&lt; &quot;HTTP status: expected ${expectedCode}, got ${actualCode}&quot;

def body = prev.getResponseDataAsString() ?: &apos;&apos;
def json = null
try { json = slurper.parseText(body) } catch (e) { errors &lt;&lt; &quot;Response is not valid JSON&quot; }

if (json != null &amp;&amp; rulesJson) {
    def schema = slurper.parseText(rulesJson)
    validateNode(json, schema, &apos;root&apos;)
}

def contractOk = errors.isEmpty()
vars.put(&apos;SC_VALIDATION_ERRORS&apos;, contractOk ? &apos;OK&apos; : errors.join(&apos;; &apos;))
if (contractOk) {
    // JMeter marks 4xx/5xx as failed by default — override when contract validates
    prev.setSuccessful(true)
} else {
    AssertionResult.setFailureMessage(errors.join(&apos;; &apos;))
    AssertionResult.setFailure(true)
}
</stringProp>
          </JSR223Assertion>
