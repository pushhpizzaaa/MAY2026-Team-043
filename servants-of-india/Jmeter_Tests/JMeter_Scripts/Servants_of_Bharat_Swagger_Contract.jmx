          <stringProp name="script">
vars.put(&apos;SC_ID&apos;, &apos;SC-002&apos;)
vars.put(&apos;SC_SCENARIO&apos;, &apos;OpenAPI documents all core paths&apos;)
vars.put(&apos;SC_STEPS&apos;, &apos;1. Parse openapi.json | 2. Assert key paths exist in spec&apos;)
vars.put(&apos;SC_EXPECTED&apos;, &apos;Paths include /auth/login, /users/me, /events, /submissions, /certificates/generate&apos;)
