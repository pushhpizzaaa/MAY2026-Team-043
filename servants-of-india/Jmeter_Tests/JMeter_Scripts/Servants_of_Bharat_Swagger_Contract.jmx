vars.put(&apos;SC_EXPECTED_CODE&apos;, &apos;200&apos;)
vars.put(&apos;SC_SCHEMA_RULES&apos;, &apos;{&quot;type&quot;: &quot;object&quot;, &quot;required&quot;: [&quot;success&quot;, &quot;data&quot;], &quot;properties&quot;: {&quot;success&quot;: {&quot;type&quot;: &quot;boolean&quot;, &quot;const&quot;: true}, &quot;data&quot;: {&quot;type&quot;: &quot;object&quot;, &quot;required&quot;: [&quot;id&quot;, &quot;slug&quot;, &quot;title&quot;, &quot;description&quot;, &quot;category_id&quot;, &quot;venue&quot;, &quot;event_date&quot;, &quot;status&quot;], &quot;properties&quot;: {&quot;id&quot;: {&quot;type&quot;: &quot;string&quot;, &quot;format&quot;: &quot;uuid&quot;}, &quot;slug&quot;: {&quot;type&quot;: &quot;string&quot;}, &quot;title&quot;: {&quot;type&quot;: &quot;string&quot;}, &quot;description&quot;: {&quot;type&quot;: &quot;string&quot;}, &quot;category_id&quot;: {&quot;type&quot;: &quot;string&quot;, &quot;format&quot;: &quot;uuid&quot;}, &quot;category_name&quot;: {&quot;type&quot;: &quot;string&quot;}, &quot;venue&quot;: {&quot;type&quot;: &quot;string&quot;}, &quot;address&quot;: {&quot;type&quot;: &quot;string&quot;}, &quot;city&quot;: {&quot;type&quot;: &quot;string&quot;}, &quot;state&quot;: {&quot;type&quot;: &quot;string&quot;}, &quot;event_date&quot;: {&quot;type&quot;: &quot;string&quot;, &quot;format&quot;: &quot;date&quot;}, &quot;start_time&quot;: {&quot;type&quot;: &quot;string&quot;}, &quot;end_time&quot;: {&quot;type&quot;: &quot;string&quot;}, &quot;status&quot;: {&quot;type&quot;: &quot;string&quot;, &quot;enum&quot;: [&quot;upcoming&quot;, &quot;completed&quot;, &quot;cancelled&quot;]}, &quot;created_by&quot;: {&quot;type&quot;: &quot;string&quot;, &quot;format&quot;: &quot;uuid&quot;}}}}}&apos;)
