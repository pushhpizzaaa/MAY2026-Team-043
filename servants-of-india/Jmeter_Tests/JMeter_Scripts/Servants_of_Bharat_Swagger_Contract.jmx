vars.put(&apos;SC_SCHEMA_RULES&apos;, &apos;{&quot;type&quot;: &quot;object&quot;, &quot;required&quot;: [&quot;success&quot;, &quot;data&quot;], &quot;properties&quot;: {&quot;success&quot;: {&quot;type&quot;: &quot;boolean&quot;, &quot;const&quot;: true}, &quot;data&quot;: {&quot;type&quot;: &quot;object&quot;, &quot;required&quot;: [&quot;valid&quot;], &quot;properties&quot;: {&quot;valid&quot;: {&quot;type&quot;: &quot;boolean&quot;, &quot;const&quot;: false}}}}}&apos;)
