          <stringProp name="script">
vars.put(&apos;SC_ID&apos;, &apos;SC-001&apos;)
vars.put(&apos;SC_SCENARIO&apos;, &apos;OpenAPI spec availability&apos;)
vars.put(&apos;SC_STEPS&apos;, &apos;1. GET /api/openapi.json | 2. Validate openapi version &amp; structure&apos;)
vars.put(&apos;SC_EXPECTED&apos;, &apos;200; openapi=3.0.3; paths object present; components.schemas present&apos;)
vars.put(&apos;SC_INPUT&apos;, &apos;GET /api/openapi.json&apos;)
