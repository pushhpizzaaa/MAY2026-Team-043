                <stringProp name="Argument.value">{&quot;full_name&quot;:&quot;Swagger Vol&quot;,&quot;email&quot;:&quot;swagger.${__UUID()}.@test.local&quot;,&quot;password&quot;:&quot;password1&quot;,&quot;phone&quot;:&quot;9876543210&quot;,&quot;location&quot;:&quot;Pune&quot;}</stringProp>
