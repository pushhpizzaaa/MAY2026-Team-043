vars.put(&apos;TC_INPUT&apos;, &apos;Admin: admin@sob.local; approve each pending submission with remarks&apos;)
vars.put(&apos;TC_COMMENTS&apos;, &apos;Super Admin can approve any submission&apos;)
vars.put(&apos;TC_EXPECTED_CODE&apos;, &apos;200&apos;)
vars.put(&apos;TC_EXPECTED_CONTAINS&apos;, &apos;[&quot;approved&quot;]&apos;)
