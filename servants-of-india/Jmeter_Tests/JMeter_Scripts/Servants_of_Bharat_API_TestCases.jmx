        </elementProp>
      </ThreadGroup>
      <hashTree>
        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Set Test Case Variables" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">false</stringProp>
          <stringProp name="script">
vars.put(&apos;TC_ID&apos;, &apos;TC-046&apos;)
vars.put(&apos;TC_SCENARIO&apos;, &apos;Create submission - duplicate pending&apos;)
vars.put(&apos;TC_STEPS&apos;, &apos;1. Submit same category while pending exists&apos;)
vars.put(&apos;TC_EXPECTED&apos;, &apos;409 pending submission exists&apos;)
vars.put(&apos;TC_INPUT&apos;, &apos;Same category_id&apos;)
vars.put(&apos;TC_COMMENTS&apos;, &apos;&apos;)
vars.put(&apos;TC_EXPECTED_CODE&apos;, &apos;409&apos;)
