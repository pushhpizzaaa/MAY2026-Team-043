            <stringProp name="JSONPostProcessor.referenceNames">VERIFY_CODE</stringProp>
            <stringProp name="JSONPostProcessor.jsonPathExprs">$.data.verification_code</stringProp>
            <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
